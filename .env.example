# Copia este archivo como .env (no se sube a git) y llena los valores. En desarrollo la API lo lee sola
# (perfil dev); en producción (P25) docker compose se los pasa al contenedor.
# Deja comentada (#) cualquier línea que no uses: una variable vacía anula el valor por defecto.

# --- Correo del sistema con Gmail (D-51) ---
# Cliente OAuth de Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth (aplicación web).
# No es la contraseña de Gmail: con esto el portal solo puede pedir permiso; la cuenta se conecta con el botón
# "Conectar con Gmail" del panel del administrador (Correo del sistema).
CORETECH_GOOGLE_ID=
CORETECH_GOOGLE_SECRETO=

# --- Registro e ingreso con Microsoft (RF-50; opcional: sin esto, el botón no aparece) ---
# Azure → Microsoft Entra ID → Registros de aplicaciones (solo cuentas Microsoft personales, tipo Web).
# URI de redirección: http://localhost:5173/api/v1/auth/externo/callback/microsoft
# (Google usa el mismo cliente de arriba: agrégale la URI .../api/v1/auth/externo/callback/google)
# CORETECH_MICROSOFT_ID=
# CORETECH_MICROSOFT_SECRETO=

# --- Solo en producción (en desarrollo hay valores locales) ---
# Clave para cifrar en la base el permiso de Gmail (mínimo 32 caracteres; no la cambies después de conectar)
# CORETECH_CIFRADO_CLAVE=
# Clave de la sesión (mínimo 32 caracteres)
# CORETECH_SESION_SECRETO=
# Dirección pública del portal (para los enlaces y el regreso de Google)
# CORETECH_URL_PORTAL=https://tu-dominio

# Clave de la base de datos de producción (docker-compose.prod.yml; sin ella no arranca)
# CORETECH_DB_CLAVE=
# Orígenes permitidos para las peticiones que cambian datos (por defecto, el mismo valor que CORETECH_URL_PORTAL)
# CORETECH_ORIGENES_PERMITIDOS=https://tu-dominio

# --- Opcional en desarrollo ---
# Mientras desarrollas, Gmail no les escribe a las cuentas demo (sus correos van a Mailpit); a los demás, sí.
# CORETECH_CORREO_DESTINOS_BLOQUEADOS=@correo.com,@coretechsolutions.co
