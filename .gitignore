# Variables de entorno con secretos (clave de Gmail, clave de la sesión…): nunca al repositorio.
# La plantilla sin valores reales es .env.example.
.env
.env.*
!.env.example

# Respaldos de la base y de los archivos (scripts/respaldo.sh): contienen datos personales
respaldos/

# Prueba de carga (carga/README.md): datos sembrados y resultados de cada corrida
carga/datos.json
carga/resultado*.json

# Certificados y llaves de Nginx (scripts/certificado-local.sh): nunca al repositorio
nginx/certs/
